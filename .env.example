# ---- PixVerse ----
# Get your key from https://docs.platform.pixverse.ai/
PIXVERSE_API_KEY=your-pixverse-api-key
# Override only if PixVerse changes their base URL.
PIXVERSE_BASE_URL=https://app-api.pixverse.ai/openapi/v2
# USD per PixVerse credit, for cost accounting. Tune to your plan (see docs/COSTS.md).
PIXVERSE_CREDIT_USD=0.012

# ---- Claude (via local Claude Code Gateway) ----
# Storylines are generated through the local Claude Code Gateway (an HTTP
# wrapper around the `claude` CLI), not the Anthropic API directly. The gateway
# supplies its own CLI auth, so no API key is needed here.
CLAUDE_GATEWAY_URL=http://localhost:8757

# ---- YouTube Shorts publishing + analytics (optional) ----
# OAuth2 credentials for the YouTube Data API v3 (uploads) and the YouTube
# Analytics API (performance sync). Grant both the upload scope and
# yt-analytics.readonly. Leave blank to run publishing AND analytics sync in
# dry-run mode (no real upload, no real analytics fetch).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Set to "true" to force dry-run even when credentials are present.
YOUTUBE_DRY_RUN=false

# ---- Server ----
PORT=4000
# Where stories, storylines, and job state are persisted.
DATA_DIR=./data
